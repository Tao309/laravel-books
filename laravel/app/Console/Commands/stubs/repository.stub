<?php

namespace {{ namespace }};

use App\CQRS\Queries\GetCollectionQueryInterface;
use {{ ModelNamespace }};
use App\Repositories\Interfaces\RepositoryInterface;
use Illuminate\Database\Eloquent\Collection;
use Illuminate\Pagination\LengthAwarePaginator;

class {{ class }} implements RepositoryInterface
{
    public function create(array $data): {{ ModelName }}
    {
        return {{ ModelName }}::create($data);
    }

    public function get(int $id): {{ ModelName }}
    {
        return {{ ModelName }}::findOrFail($id);
    }

    public function getAll(GetCollectionQueryInterface $query): Collection
    {
        return {{ ModelName }}::all();
    }

    public function getAllPaginate(GetCollectionQueryInterface $query): LengthAwarePaginator
    {
        return {{ ModelName }}::paginate();
    }

    public function update(int $id, array $data): {{ ModelName }}
    {
        $entity = {{ ModelName }}::findOrFail($id);
        $entity->update($data);

        return $entity;
    }

    public function delete($id): bool
    {
        $entity = {{ ModelName }}::findOrFail($id);

        return $entity->delete();
    }
}
