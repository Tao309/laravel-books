<?php

namespace {{ namespace }};

use App\CQRS\CommandBus;
use {{ CreateModelCommandNamespace }};
use {{ UpdateModelCommandNamespace }};
use {{ GetByIdModelQueryNamespace }};
use {{ GetModelsQueryNamespace }};
use App\DTOs\DtoInterface;
use App\Models\{{ ModelName }};
use Illuminate\Database\Eloquent\Collection;
use Illuminate\Pagination\LengthAwarePaginator;

readonly class {{ class }} implements ServiceInterface
{
    public function __construct(
        private CommandBus $bus,
    ) {}

    public function getList(): Collection
    {
        return $this->bus->dispatch(new {{ GetModelsQueryName }});
    }

    public function getListPaginate(): LengthAwarePaginator
    {
        return $this->bus->dispatch(new {{ GetModelsQueryName }});
    }

    public function getById(int $id): {{ ModelName }}
    {
        return $this->bus->dispatch(new {{ GetByIdModelQueryName }}($id));
    }

    public function create(DtoInterface $dto): {{ ModelName }}
    {
        $command = new {{ CreateModelCommandName }}($dto);

        return $this->bus->dispatch($command);
    }

    public function updateById(int $id, DtoInterface $dto): {{ ModelName }}
    {
        $command = new {{ UpdateModelCommandName }}($id, $dto);

        return $this->bus->dispatch($command);
    }
}
