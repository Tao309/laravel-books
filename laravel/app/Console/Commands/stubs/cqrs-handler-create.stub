class {{ class }}
{
    /**
     * @param  {{ RepositoryName }}  $repository
     */
    public function __construct(
        public RepositoryInterface $repository,
    ) {}

    /**
     * @throws ApiException
     */
    public function handle({{ CreateCommandName }} $command): {{ ModelName }}
